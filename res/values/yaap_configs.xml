<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Device specific doze package -->
    <string name="config_customDozePackage" translatable="false"></string>

    <!-- Show battery information -->
    <bool name="config_show_battery_info" translatable="false">true</bool>

    <!-- Show battery cycle count -->
    <bool name="config_show_battery_cycle_count" translatable="false">true</bool>

    <!-- Show haptic styles -->
    <bool name="config_supportHapticProfiles" translatable="false">false</bool>

    <!-- Show high touch polling rate option -->
    <bool name="config_supportHighTouchRate" translatable="false">false</bool>

    <!-- Show LTPO features option -->
    <bool name="config_supportLtpoFeatures" translatable="false">false</bool>

    <!-- Hide disable VRR option -->
    <bool name="config_disableVrrSetting" translatable="false">false</bool>

    <!-- Show DC Dim settings and schedule -->
    <bool name="config_showDcDimSettings" translatable="false">false</bool>

    <!-- Uses the legacy UDFPS enrollment UI with side text instead of a footer button. -->
    <bool name="config_useLegacyUdfpsUi" translatable="false">false</bool>

    <!-- Whether eSIM power control is supported on this device -->
    <bool name="config_supportEsimPowerControl">false</bool>
</resources>
